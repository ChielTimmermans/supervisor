MM_URL=https://mattermost.example.com
MM_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxx
MM_CHANNEL_ID=xxxxxxxxxxxxxxxxxxxxxxxxx
REPOS_JSON={"acme-api":{"path":"/Users/chiel/projects/acme-api","description":"Main API service"}}
WORKER_CONCURRENCY=3
ASK_USER_TIMEOUT_MS=86400000
# Alert-ingest channels the bot listens to (bot must be a member). source: prometheus | glitchtip
INGEST_CHANNELS_JSON=[{"channelId":"xxxxxxxxxxxxxxxxxxxxxxxxx","source":"prometheus"},{"channelId":"yyyyyyyyyyyyyyyyyyyyyyyyy","source":"glitchtip"}]
# Map an alert's service/label value to a repo registry name; unmapped alerts diagnose in a scratch dir
SERVICE_REPO_MAP_JSON={"console-frontend":"chipmakers"}
# Cooldown before the same incident fingerprint re-opens an investigation (ms)
INCIDENT_COOLDOWN_MS=3600000
# Read-only access for investigation workers (present in the devbox env, inherited by workers):
# KUBECONFIG=/home/dev/.kube/readonly-config
# PROM_URL=https://prometheus.internal   PROM_TOKEN=...
# GLITCHTIP_URL=https://console.thechipmakers.dev   GLITCHTIP_TOKEN=...
ATTACHMENT_DIR=./scratch/attachments
DB_PATH=./data/supervisor.sqlite
# Logging verbosity: silent | error | warn | info | debug  (default: info)
LOG_LEVEL=info
